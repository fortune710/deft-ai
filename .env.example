# Convex
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Clerk: copy these from https://dashboard.clerk.com/last-active?path=api-keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Clerk Frontend API URL; also set this in each Convex deployment's environment.
CLERK_JWT_ISSUER_DOMAIN=https://your-clerk-instance.clerk.accounts.dev
# Alternative name used by Clerk's integration guide.
CLERK_FRONTEND_API_URL=https://your-clerk-instance.clerk.accounts.dev
# Set the same long random value in Trigger.dev and each Convex deployment.
TRIGGER_CONVEX_SECRET=
# AI providers used by chat responses, security scanning, and attachment embeddings.
GEMINI_API_KEY=
XAI_API_KEY=
COHERE_API_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/content-engine
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding
